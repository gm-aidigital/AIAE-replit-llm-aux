# =============================================================================
# .env.example — copy to .env (gitignored) for local-dev, or set these in the
# Replit Secrets pane for workspace and Deployment.
#
# Anything prefixed with VITE_ is exposed to the browser by Vite. NEVER put
# secrets there.
# =============================================================================

# -- Spring profile (overridden by .replit [env] on Replit) -------------------
SPRING_PROFILES_ACTIVE=local

# -- Server -------------------------------------------------------------------
PORT=8080
APP_CONTEXT_PATH=
APP_SERVICE_NAME=generated-mvp
BACKEND_DEV_PORT=5000
VITE_API_BASE_URL=
VITE_API_CONTEXT_PATH=

# -- PostgreSQL (local-dev fallback; on Replit, PG* vars are injected) -------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Auth (Clerk SSO — the ONLY auth mode) -----------------------------------
# REQUIRED: the backend fails fast at startup if neither issuer nor JWKS is set.
AUTH_ISSUER_URI=
AUTH_JWKS_URI=
AUTH_AUDIENCE=
# Clerk SSO keys — auto-injected by Replit's managed Clerk integration.
# Leave blank if not yet provisioned (the app will not start until SSO is set).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# -- Auth (frontend, Vite-exposed) -------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# -- Usage logging (PostgresUsageLogger → usage_events table) ----------------
USAGE_LOGGING_ENABLED=true
USAGE_LOG_SERVICE_NAME=generated-mvp
USAGE_LOG_ENVIRONMENT=dev

# -- External setup (informational; configured in Clerk Dashboard) -----------
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET live inside Clerk in the preferred
# flow. Do NOT inject these into the application runtime.
